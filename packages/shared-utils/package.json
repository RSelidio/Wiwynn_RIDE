{
  "name": "@shuttle/shared-utils",
  "version": "0.1.0",
  "private": true,
  "description": "Geo, ETA, time and formatting helpers shared by the backend and every client",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "@shuttle/shared-types": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
