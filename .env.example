# ─────────────────────────────────────────────────────────────────────────────
# Company Shuttle — environment template
#
# Copy to .env and fill in real values. Never commit .env.
# On the Windows cloud server these values are set per environment (DEV / PROD)
# through Azure DevOps variable groups, not from this file.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# Demo-only seed data is disabled by default. Set true only when intentionally
# loading fictional Hsinchu fixtures into a disposable development database.
ALLOW_DEMO_SEED=false

# ── Backend (apps/backend) ───────────────────────────────────────────────────
PORT=4000
# Bind to loopback only in production — IIS reverse-proxies to it, so the
# Node port must never be publicly reachable (spec §14).
HOST=127.0.0.1

# Comma-separated list of origins allowed to call the API / open a socket.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081,http://localhost:8082

# ── PostgreSQL (spec §11) ────────────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=shuttle_dev
PGUSER=shuttle_app
PGPASSWORD=change-me
# Set to "require" when Postgres is on a different host than the Node apps.
PGSSLMODE=disable
PG_POOL_MAX=10

# ── Authentication (spec §12) ────────────────────────────────────────────────
# Local auth for DEV. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-change-me-to-a-48-byte-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# Entra ID / SSO — left blank until company IT approves. When these are set the
# backend exposes /api/auth/sso alongside local login; see docs/authentication.md.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=

# ── GPS + ETA engine (spec §3, §6) ───────────────────────────────────────────
# How often the driver app is asked to push a fix.
GPS_PUSH_INTERVAL_SEC=8
# Latest position is kept in memory; history is persisted no more often than this.
GPS_HISTORY_PERSIST_SEC=45
# A fix older than this marks the shuttle's GPS as stale.
GPS_STALE_AFTER_SEC=30
# Metres around a stop that count as "at the stop".
STOP_GEOFENCE_M=50
# Fallback average speed when a shuttle has no usable recent speed reading.
ETA_FALLBACK_SPEED_KMH=22
# Weight given to observed historical segment times vs configured times (0..1).
ETA_HISTORY_WEIGHT=0.6

# Optional OSRM-compatible road router. Development defaults to the public
# OSRM demo for light testing; production should use a company-hosted OSRM
# endpoint and must not depend on the public demo server.
OSRM_BASE_URL=

# ── Frontends ────────────────────────────────────────────────────────────────
# Employee PWA (apps/employee) and Admin (apps/admin). Browser-exposed, so these
# must be absolute URLs reachable from the user's device, not localhost, in PROD.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Optional map style override; blank uses the configured OpenStreetMap layer.
NEXT_PUBLIC_MAP_STYLE_URL=
